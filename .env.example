# ============================================================================
# Memory Rhythm — backend environment template
# ----------------------------------------------------------------------------
# Copy to backend/.env  (or export these vars) before running uvicorn.
#   cp .env.example backend/.env
#
# DEFAULTS BOOT THE DEMO WITH ZERO SECRETS:
#   AI_PROVIDER=mock + STORE=memory  -> no database, no API key needed.
# Provider selection is PER CAPABILITY. AI_PROVIDER is just the global default;
# any LLM_/STT_/TTS_/IMAGE_/EMBEDDING_PROVIDER override below wins for its slot.
# If a selected provider's key/SDK is missing, that capability transparently
# falls back to mock (the app NEVER crashes for a missing secret).
# ============================================================================

# ---- AI provider selection -------------------------------------------------
# Valid values for every *_PROVIDER var: mock | openai | google
#   mock   = deterministic Korean canned/templated responses (offline demo)
#   openai = GPT-4o (reasoner) / GPT-4o-mini (dialogue) / Whisper / TTS /
#            gpt-image-1 / text-embedding-3-large
#   google = Gemini 2.5 Flash (LLM) / Cloud Speech-to-Text / Imagen /
#            gemini-embedding-001   (no Google TTS — google TTS falls back to mock)
AI_PROVIDER=mock            # global default; per-capability overrides below win

# Per-capability overrides (each defaults to AI_PROVIDER if left unset/blank):
# LLM_PROVIDER=google         # 두뇌(reasoner) + 입(dialogue)
# STT_PROVIDER=google         # speech-to-text
# TTS_PROVIDER=mock           # text-to-speech (mock | openai | elevenlabs; no Google TTS)
# IMAGE_PROVIDER=google       # autobiography illustrations
# EMBEDDING_PROVIDER=google   # text embeddings

# ---- Preset: Google for everything except TTS ------------------------------
# Uncomment this block for the user's setup (Gemini API for LLM/Image/Embedding,
# Google Cloud Speech-to-Text for STT, silent mock TTS):
# AI_PROVIDER=google
# TTS_PROVIDER=mock
# STT_PROVIDER=google        # Google Cloud Speech-to-Text (needs GOOGLE_APPLICATION_CREDENTIALS / project)
# GOOGLE_API_KEY=...         # Gemini API: LLM + Image(Imagen) + Embedding
# GOOGLE_CLOUD_PROJECT=...   # for Cloud Speech-to-Text
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# ---- Preset: ElevenLabs voice for TTS --------------------------------------
# Real Korean-capable voice while keeping LLM/STT/etc. on mock or google.
# Only TTS_PROVIDER accepts "elevenlabs" (it implements TTS and nothing else).
# Leave the key blank and it falls back to silent mock (demo still boots).
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...                       # required to actually speak
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM     # optional; default "Rachel"
# ELEVENLABS_MODEL=eleven_flash_v2_5           # optional; cheap + multilingual (default)

# ---- Preset: Amazon Polly for TTS (native Korean voices) -------------------
# TTS_PROVIDER=polly accepts AWS credentials from boto3's default chain (an EC2
# instance role in prod — see deploy-aws.ps1 -Polly — or local `aws configure`).
# Korean voices: Seoyeon (standard|neural|generative) and Jihye (neural).
# TTS_PROVIDER=polly
# POLLY_REGION=ap-northeast-2                   # optional; else AWS_REGION / instance region
# POLLY_VOICE=Seoyeon                           # optional; default Seoyeon
# POLLY_ENGINE=neural                           # optional; neural | generative | standard

# ---- OpenAI credentials ----------------------------------------------------
# Required only when any capability selects openai. Leave blank for mock demo.
OPENAI_API_KEY=

# ---- Google credentials ----------------------------------------------------
# Gemini API key from Google AI Studio — powers google LLM + Image + Embedding.
# GOOGLE_API_KEY and GEMINI_API_KEY are aliases (GOOGLE_API_KEY wins if both set).
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alias for GOOGLE_API_KEY (AI Studio naming)
# Google Cloud Speech-to-Text is separate from the Gemini API key: it uses
# Application Default Credentials / a service account, NOT GOOGLE_API_KEY.
GOOGLE_CLOUD_PROJECT=        # project id for Cloud Speech-to-Text
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON (ADC)

# ---- Embedding dimensions --------------------------------------------------
# EMBED_DIM=256              # mock pseudo-vector dimension
# GOOGLE_EMBED_DIM=768       # gemini-embedding-001 output_dimensionality

# ---- Model overrides (optional) --------------------------------------------
# Resolved automatically from LLM_PROVIDER (openai -> gpt-4o / gpt-4o-mini;
# google -> gemini-2.5-flash / gemini-2.5-flash; mock -> mock-*). Override here:
# REASONING_MODEL=gemini-2.5-flash   # the 두뇌 (reasoner) model
# DIALOGUE_MODEL=gemini-2.5-flash    # the 입 (dialogue) model

# Optional: nicer Korean TTS. Only consulted if you wire the ElevenLabs path.
ELEVENLABS_API_KEY=

# ---- Store backend ---------------------------------------------------------
# memory = in-memory singleton store (the only one needed for the demo).
# (Postgres/Neo4j/Redis-backed stores land in M1+; see docker-compose.yml.)
STORE=memory

# ============================================================================
# OPTIONAL data-layer connection strings (M1+). Unused while STORE=memory.
# These line up with docker-compose.yml. The demo never reads them.
# ============================================================================
# DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_rhythm
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=memoryrhythm
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio12345
# MINIO_BUCKET=autobiography
