# ============================================================================
# Memory Rhythm — repository-root .gitignore
# (frontend/.gitignore is maintained separately by the frontend toolchain)
# ============================================================================

# ---- Secrets / local env ---------------------------------------------------
.env
.env.local
.env.*.local
*.local

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
develop-eggs/
.installed.cfg
.Python

# virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv/

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# ---- Node / frontend build artifacts ---------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Local tooling config (not part of the project) ------------------------
.claude/

# ---- Misc / runtime --------------------------------------------------------
*.log
logs/
# SQLite persistence DB (patient data accumulates here at runtime).
backend/data/
*.db
*.sqlite3
# Built SPA staged into the backend for single-host deploy (regenerated by
# `vite build` + copy → backend/static; the deploy script rebuilds it).
backend/static/

# ---- Adopted-frontend swap (2026-06) ---------------------------------------
# The previous Vite/React-18 frontend was retired into frontend-legacy/ (kept
# locally for reference, recoverable from git history) — do not commit it.
frontend-legacy/

# ---- Harvested Replit prototype --------------------------------------------
# The Memory-Rhythm/ monorepo was harvested into frontend/ (shadcn UI) plus the
# backend dashboard endpoints; kept locally for reference only, not committed.
Memory-Rhythm/
.commitmsg.txt
